{
  "name": "sherpa-api-mock",
  "type": "module",
  "version": "1.0.0",
  "description": "Fake of the Sherpa API for development and testing",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "reset": "node --env-file-if-exists=.env src/reset.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "spec:update": "node scripts/update-spec.ts",
    "docker:build": "docker build . -t verdigado/sherpa-api-mock:latest",
    "docker:run": "docker run --env-file ./.env -d -p 5000:5000 verdigado/sherpa-api-mock:latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
